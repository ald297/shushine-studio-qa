{
	"info": {
		"_postman_id": "7f8b91a2-3c4d-5e6f-8a9b-0c1d2e3f4a5b",
		"name": "Shushine Studio API - Suite Completa",
		"description": "Colección completa de pruebas funcionales, de integración y seguridad para la API REST de Shushine Studio (Spring Boot 3.3.3 / Supabase PostgreSQL). Incluye aserciones automáticas y encadenamiento de autenticación JWT.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Autenticación y Cuentas",
			"item": [
				{
					"name": "Login - Iniciar Sesión (Obtiene JWT)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Respuesta contiene token JWT válido\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('token');",
									"    pm.expect(jsonData.token).to.be.a('string');",
									"    pm.environment.set(\"token\", jsonData.token);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": { 
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"login\": \"{{admin_username}}\",\n  \"clave\": \"{{admin_password}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Autentica al usuario en el sistema. El script de tests guarda automáticamente el token JWT en la variable de entorno {{token}}."
					},
					"response": []
				},
				{
					"name": "Registro de Usuario",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 201 Created, 200 OK o 409 (Usuario existente)\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 201, 409]);",
									"});",
									"",
									"pm.test(\"Respuesta incluye token o estructura de respuesta\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.token || jsonData.detail || jsonData.title || jsonData.status).to.be.ok;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombre\": \"Cliente\",\n  \"apellidos\": \"Prueba\",\n  \"correo\": \"cliente_{{$timestamp}}@shushine.test\",\n  \"nombreUsuario\": \"user_{{$timestamp}}\",\n  \"clave\": \"ClaveSegura123!\",\n  \"telefono\": \"5551234567\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/registro",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"registro"
							]
						}
					},
					"response": []
				},
				{
					"name": "Obtener Perfil (/me)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Perfil validado con datos del usuario\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.login || jsonData.nombreUsuario).to.be.ok;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/auth/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"me"
							]
						}
					},
					"response": []
				}
			]
		},
